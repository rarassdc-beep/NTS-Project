<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NUKLIR & SPACE OUTREACH - Media Interaktif</title>
    <!-- Pixel Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #032820;
            --bg-card: #08652C;
            --accent-green: #5FCA00;
            --accent-lime: #80A416;
            --accent-gold: #AD9F3C;
            --accent-orange: #E87305;
            --accent-pink: #F2ECDE;
            --text-light: #F2ECDE;
            --text-dark: #032820;
            --font-pixel: 'Press Start 2P', monospace;
            --font-body: 'VT323', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            image-rendering: pixelated;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            font-family: var(--font-body);
            font-size: 20px;
            line-height: 1.4;
            overflow-x: hidden;
            background-image: 
                radial-gradient(var(--accent-lime) 1px, transparent 0),
                radial-gradient(var(--accent-orange) 1px, var(--bg-dark) 0);
            background-size: 40px 40px;
            background-position: 0 0, 20px 20px;
            position: relative;
        }

        /* CRT Scanline Effect */
        body::before {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            background-size: 100% 4px;
            z-index: 999;
            pointer-events: none;
            opacity: 0.6;
        }

        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        /* Pixel Container Border */
        .pixel-box {
            background: var(--bg-card);
            border: 4px solid var(--accent-green);
            box-shadow: 
                -6px 0 0 0 var(--text-dark),
                6px 0 0 0 var(--text-dark),
                0 -6px 0 0 var(--text-dark),
                0 6px 0 0 var(--text-dark),
                0 0 0 6px var(--accent-green),
                8px 8px 0px 4px rgba(0,0,0,0.5);
            padding: 20px;
            margin-bottom: 30px;
            position: relative;
        }

        .pixel-box-orange {
            border-color: var(--accent-orange);
            box-shadow: 
                -6px 0 0 0 var(--text-dark),
                6px 0 0 0 var(--text-dark),
                0 -6px 0 0 var(--text-dark),
                0 6px 0 0 var(--text-dark),
                0 0 0 6px var(--accent-orange),
                8px 8px 0px 4px rgba(0,0,0,0.5);
        }

        header {
            text-align: center;
            padding: 30px 10px;
        }

        h1 {
            font-family: var(--font-pixel);
            font-size: 1.8rem;
            color: var(--accent-green);
            text-shadow: 4px 4px #000, -2px -2px var(--accent-orange);
            margin-bottom: 15px;
            line-height: 1.3;
        }

        .subtitle {
            font-size: 1.4rem;
            color: var(--accent-pink);
            background: rgba(3, 40, 32, 0.8);
            display: inline-block;
            padding: 5px 15px;
            border: 2px dashed var(--accent-lime);
        }

        .sound-toggle {
            position: fixed;
            top: 15px;
            right: 15px;
            z-index: 1000;
            background: var(--accent-orange);
            color: var(--text-light);
            border: none;
            padding: 10px;
            font-family: var(--font-pixel);
            font-size: 0.7rem;
            cursor: pointer;
            box-shadow: 3px 3px 0 #000;
        }

        .sound-toggle:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0 #000;
        }

        h2.section-title {
            font-family: var(--font-pixel);
            font-size: 1.2rem;
            color: var(--accent-orange);
            margin-bottom: 20px;
            text-shadow: 2px 2px #000;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Level Grid */
        .grid-levels {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }

        .level-card {
            background: rgba(3, 40, 32, 0.9);
            border: 3px solid var(--accent-lime);
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: transform 0.1s, border-color 0.2s;
            position: relative;
        }

        .level-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-orange);
            background: #06402A;
        }

        .level-badge {
            font-family: var(--font-pixel);
            font-size: 0.6rem;
            background: var(--accent-orange);
            color: var(--text-light);
            padding: 4px 8px;
            position: absolute;
            top: -12px;
            left: 10px;
            border: 1px solid #000;
        }

        .level-icon {
            font-size: 2.5rem;
            margin: 15px 0 10px;
        }

        .level-title {
            font-family: var(--font-pixel);
            font-size: 0.8rem;
            color: var(--accent-green);
            margin-bottom: 8px;
        }

        /* Modal Popup */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            padding: 20px;
        }

        .modal-content {
            background: var(--bg-dark);
            border: 4px solid var(--accent-orange);
            padding: 25px;
            max-width: 600px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            position: relative;
            box-shadow: 0 0 20px var(--accent-orange);
        }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 15px;
            font-family: var(--font-pixel);
            font-size: 1rem;
            background: var(--accent-orange);
            color: #fff;
            border: none;
            cursor: pointer;
            padding: 5px 10px;
        }

        .modal-body ul {
            list-style-type: square;
            margin-left: 20px;
            margin-top: 10px;
        }

        .modal-body li {
            margin-bottom: 10px;
        }

        /* Quiz Section */
        .quiz-container {
            background: rgba(3, 40, 32, 0.95);
            padding: 15px;
            border: 2px dashed var(--accent-green);
        }

        .quiz-question {
            font-family: var(--font-pixel);
            font-size: 0.8rem;
            color: var(--accent-pink);
            margin-bottom: 15px;
            line-height: 1.4;
        }

        .quiz-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .option-btn {
            background: var(--bg-card);
            color: var(--text-light);
            border: 2px solid var(--accent-lime);
            padding: 10px;
            font-family: var(--font-body);
            font-size: 1.2rem;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
        }

        .option-btn:hover {
            background: var(--accent-lime);
            color: var(--text-dark);
        }

        /* Team Section */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 15px;
        }

        .member-card {
            background: rgba(3, 40, 32, 0.8);
            border: 2px solid var(--accent-gold);
            padding: 10px;
            text-align: center;
        }

        .avatar {
            width: 64px;
            height: 64px;
            margin: 0 auto 10px;
            background: var(--bg-card);
            border: 2px solid var(--accent-green);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .member-name {
            font-family: var(--font-pixel);
            font-size: 0.65rem;
            color: var(--accent-orange);
            margin-bottom: 5px;
        }

        .member-role {
            font-size: 0.9rem;
            color: var(--accent-pink);
        }

        footer {
            text-align: center;
            padding: 20px;
            font-family: var(--font-pixel);
            font-size: 0.6rem;
            color: var(--accent-gold);
            border-top: 2px dashed var(--accent-lime);
            margin-top: 20px;
        }

        @media (max-width: 600px) {
            h1 { font-size: 1.2rem; }
            .subtitle { font-size: 1rem; }
            .grid-levels { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <canvas id="particle-canvas"></canvas>
    <button class="sound-toggle" onclick="toggleSound()">🔊 SFX: ON</button>

    <div class="container">
        <!-- HEADER -->
        <header>
            <h1>ATOMIK & SPACE OUTREACH</h1>
            <div class="subtitle">🚀 Media Belajar Edukasi Nuklir Interaktif</div>
        </header>

        <!-- PENGENALAN -->
        <section class="pixel-box">
            <h2 class="section-title">👾 WELCOME HERO!</h2>
            <p>Tahukah kamu? Nuklir bukan sekadar bom atau radiasi berbahaya! Dari energi listrik bersih, kesehatan, hingga penjelajahan luar angkasa, teknologi nuklir ada di sekeliling kita. Pilih modul di bawah ini untuk memulai petualangan sainsmu!</p>
        </section>

        <!-- MODUL MATERI / LEVEL -->
        <section class="pixel-box pixel-box-orange">
            <h2 class="section-title">🕹️ PILIH LEVEL MATERI</h2>
            <div class="grid-levels">
                
                <div class="level-card" onclick="openModule(1)">
                    <span class="level-badge">LEVEL 1</span>
                    <div class="level-icon">☢️</div>
                    <div class="level-title">Radiasi Sekitar</div>
                    <p style="font-size: 0.9rem;">Pisang juga punya radiasi?! Yuk cek faktanya.</p>
                </div>

                <div class="level-card" onclick="openModule(2)">
                    <span class="level-badge">LEVEL 2</span>
                    <div class="level-icon">⚡</div>
                    <div class="level-title">Nuklir Sehari-hari</div>
                    <p style="font-size: 0.9rem;">Dari deteksi penyakit hingga energi listrik bersih.</p>
                </div>

                <div class="level-card" onclick="openModule(3)">
                    <span class="level-badge">LEVEL 3</span>
                    <div class="level-icon">👨‍🚀</div>
                    <div class="level-title">Nuklir & Antariksa</div>
                    <p style="font-size: 0.9rem;">Baterai roket & perjalanan kosmonot ke ruang hampa.</p>
                </div>

                <div class="level-card" onclick="openModule(4)">
                    <span class="level-badge">LEVEL 4</span>
                    <div class="level-icon">🛡️</div>
                    <div class="level-title">Proteksi Radiasi</div>
                    <p style="font-size: 0.9rem;">3 Aturan emas agar tetap aman dari radiasi!</p>
                </div>

            </div>
        </section>

        <!-- MINI QUIZ GAME -->
        <section class="pixel-box">
            <h2 class="section-title">🎮 MINI QUIZ: UJI PENGETAHUAN</h2>
            <div class="quiz-container" id="quiz-box">
                <div class="quiz-question" id="quiz-question">Loading Pertanyaan...</div>
                <div class="quiz-options" id="quiz-options"></div>
                <div id="quiz-feedback" style="margin-top: 15px; font-family: var(--font-pixel); font-size: 0.7rem;"></div>
            </div>
        </section>

        <!-- TIM OUTREACH (6 MEMBER) -->
        <section class="pixel-box pixel-box-orange">
            <h2 class="section-title">👥 TIM OUTREACH PROJECT</h2>
            <p style="margin-bottom: 15px;">Kenalan dengan 6 anggota tim edukator di balik proyek ini:</p>
            <div class="team-grid">
                
                <div class="member-card">
                    <div class="avatar">
                        <svg width="40" height="40" viewBox="0 0 8 8">
                            <rect x="2" y="1" width="4" height="3" fill="#E87305"/>
                            <rect x="3" y="2" width="2" height="1" fill="#F2ECDE"/>
                            <rect x="1" y="4" width="6" height="4" fill="#5FCA00"/>
                        </svg>
                    </div>
                    <div class="member-name">Member 1</div>
                    <div class="member-role">Team Leader</div>
                </div>

                <div class="member-card">
                    <div class="avatar">
                        <svg width="40" height="40" viewBox="0 0 8 8">
                            <rect x="2" y="1" width="4" height="3" fill="#80A416"/>
                            <rect x="2" y="2" width="4" height="1" fill="#032820"/>
                            <rect x="1" y="4" width="6" height="4" fill="#E87305"/>
                        </svg>
                    </div>
                    <div class="member-name">Member 2</div>
                    <div class="member-role">Content Creator</div>
                </div>

                <div class="member-card">
                    <div class="avatar">
                        <svg width="40" height="40" viewBox="0 0 8 8">
                            <rect x="2" y="1" width="4" height="3" fill="#AD9F3C"/>
                            <rect x="3" y="2" width="2" height="2" fill="#F2ECDE"/>
                            <rect x="1" y="4" width="6" height="4" fill="#08652C"/>
                        </svg>
                    </div>
                    <div class="member-name">Member 3</div>
                    <div class="member-role">Web Developer</div>
                </div>

                <div class="member-card">
                    <div class="avatar">
                        <svg width="40" height="40" viewBox="0 0 8 8">
                            <rect x="2" y="1" width="4" height="3" fill="#F2ECDE"/>
                            <rect x="2" y="2" width="4" height="1" fill="#E87305"/>
                            <rect x="1" y="4" width="6" height="4" fill="#80A416"/>
                        </svg>
                    </div>
                    <div class="member-name">Member 4</div>
                    <div class="member-role">Graphic Designer</div>
                </div>

                <div class="member-card">
                    <div class="avatar">
                        <svg width="40" height="40" viewBox="0 0 8 8">
                            <rect x="2" y="1" width="4" height="3" fill="#5FCA00"/>
                            <rect x="3" y="2" width="2" height="1" fill="#032820"/>
                            <rect x="1" y="4" width="6" height="4" fill="#AD9F3C"/>
                        </svg>
                    </div>
                    <div class="member-name">Member 5</div>
                    <div class="member-role">Outreach Coordinator</div>
                </div>

                <div class="member-card">
                    <div class="avatar">
                        <svg width="40" height="40" viewBox="0 0 8 8">
                            <rect x="2" y="1" width="4" height="3" fill="#E87305"/>
                            <rect x="2" y="2" width="4" height="2" fill="#F2ECDE"/>
                            <rect x="1" y="4" width="6" height="4" fill="#032820"/>
                        </svg>
                    </div>
                    <div class="member-name">Member 6</div>
                    <div class="member-role">Public Relation</div>
                </div>

            </div>
        </section>

        <footer>
            <p>PROJECT MEDIA OUTREACH © 2026 | CREATED FOR TARGET YOUTH (10-25 THN)</p>
        </footer>
    </div>

    <!-- MODAL POPUP MATERI -->
    <div class="modal-overlay" id="modal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModule()">X</button>
            <h2 id="modal-title" style="font-family: var(--font-pixel); color: var(--accent-orange); margin-bottom: 15px; font-size: 1rem;">Judul Modul</h2>
            <div class="modal-body" id="modal-body">
                <!-- Isi materi dimuat via JS -->
            </div>
        </div>
    </div>

    <script>
        // Data Modul Sains Disederhanakan
        const moduleData = {
            1: {
                title: "LEVEL 1: RADIAST SEKITAR KITA",
                content: `
                    <p>Radiasi bukan hal yang selalu berbahaya! Secara alami, alam semesta memancarkan radiasi latar belakang setiap hari.</p>
                    <ul>
                        <li><b>Sinar Matahari:</b> Mengandung sinar ultraviolet yang memberikan vitamin D bagi tubuh.</li>
                        <li><b>Buah Pisang:</b> Mengandung Kalium-40 yang secara alami bersifat radioaktif dalam jumlah sangat aman!</li>
                        <li><b>Radiasi Pengion vs Non-Pengion:</b> Radiasi pengion (seperti Sinar-X) punya energi tinggi, sedangkan sinyal HP & WiFi adalah radiasi non-pengion yang aman.</li>
                    </ul>
                    <p style="margin-top:10px; color:var(--accent-lime);">💡 <i>Fun Fact:</i> Makanan sehari-hari seperti kacang dan kentang juga punya sedikit jejak radiasi alami!</p>
                `
            },
            2: {
                title: "LEVEL 2: NUKLIR DALAM SEHARI-HARI",
                content: `
                    <p>Teknologi nuklir digunakan di berbagai bidang modern untuk membantu kehidupan kita:</p>
                    <ul>
                        <li><b>Kesehatan (Kedokteran Nuklir):</b> Digunakan untuk deteksi dini penyakit sel kanker serta sterilisasi alat medis secara cepat.</li>
                        <li><b>Pertanian Unggul:</b> Mutasi radiasi membantu menciptakan benih tanaman padi yang tahan hama dan menghasilkan panen melimpah.</li>
                        <li><b>PLTN (Energi Bersih):</b> Pembangkit Listrik Tenaga Nuklir tidak menghasilkan emisi gas rumah kaca sehingga sangat ramah lingkungan.</li>
                    </ul>
                `
            },
            3: {
                title: "LEVEL 3: NUKLIR & PENJELAJAHAN ANTARIKSA",
                content: `
                    <p>Bagaimana pesawat luar angkasa bisa bertahan di kegelapan antariksa yang jauh dari matahari?</p>
                    <ul>
                        <li><b>Baterai Nuklir (RTG):</b> Radioisotope Thermoelectric Generator mengubah panas dari peluruhan radioaktif menjadi listrik untuk wahana antariksa seperti <i>Voyager</i> & <i>Rover Mars Curiosity</i>.</li>
                        <li><b>Misi Cosmonaut:</b> Para astronot/kosmonot di stasiun luar angkasa terlindungi oleh perisai khusus dari radiasi kosmik alam semesta.</li>
                    </ul>
                `
            },
            4: {
                title: "LEVEL 4: PROTEKSI & KEAMANAN RADIASI",
                content: `
                    <p>Dalam memanfaatkan teknologi nuklir, prinsip keamanan <b>ALARA</b> (As Low As Reasonably Achievable) selalu diterapkan lewat 3 langkah mudah:</p>
                    <ul>
                        <li><b>1. Waktu (Time):</b> Meminimalkan durasi berada di dekat sumber radiasi.</li>
                        <li><b>2. Jarak (Distance):</b> Semakin jauh posisi kita dari sumber radiasi, paparan yang diterima akan berkurang drastis.</li>
                        <li><b>3. Perisai (Shielding):</b> Menggunakan penghalang khusus seperti lapisan timbal atau beton tebal.</li>
                    </ul>
                `
            }
        };

        // Data Kuis Interaktif
        const quizQuestions = [
            {
                q: "1. Manakah buah sehari-hari yang mengandung unsur radioaktif alami (Kalium-40)?",
                options: ["Apple", "Pisang", "Semangka"],
                answer: 1
            },
            {
                q: "2. Apa nama alat/baterai nuklir yang dipakai wahana antariksa penjelajah Mars?",
                options: ["Baterai AA", "RTG (Radioisotope Generator)", "Panel Kayu"],
                answer: 1
            },
            {
                q: "3. Tiga prinsip dasar proteksi radiasi adalah Waktu, Jarak, dan...?",
                options: ["Perisai (Shielding)", "Kecepatan", "Suhu"],
                answer: 0
            }
        ];

        let currentQuizIndex = 0;
        let soundEnabled = true;

        // Audio Effects (Web Audio API)
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playPixelSound(freq = 440, type = 'square', duration = 0.1) {
            if (!soundEnabled) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch(e){}
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const btn = document.querySelector('.sound-toggle');
            btn.innerText = soundEnabled ? "🔊 SFX: ON" : "🔇 SFX: OFF";
        }

        // Modal Functionality
        function openModule(id) {
            playPixelSound(600, 'square', 0.15);
            document.getElementById('modal-title').innerText = moduleData[id].title;
            document.getElementById('modal-body').innerHTML = moduleData[id].content;
            document.getElementById('modal').style.display = 'flex';
        }

        function closeModule() {
            playPixelSound(300, 'sawtooth', 0.1);
            document.getElementById('modal').style.display = 'none';
        }

        // Quiz Logic
        function loadQuiz() {
            const qData = quizQuestions[currentQuizIndex];
            document.getElementById('quiz-question').innerText = qData.q;
            const optContainer = document.getElementById('quiz-options');
            optContainer.innerHTML = '';
            document.getElementById('quiz-feedback').innerText = '';

            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerText = opt;
                btn.onclick = () => checkAnswer(idx);
                optContainer.appendChild(btn);
            });
        }

        function checkAnswer(selectedIdx) {
            const qData = quizQuestions[currentQuizIndex];
            const feedback = document.getElementById('quiz-feedback');
            if (selectedIdx === qData.answer) {
                playPixelSound(800, 'triangle', 0.2);
                feedback.style.color = '#5FCA00';
                feedback.innerText = "✅ BENAR! HEBAT!";
                setTimeout(() => {
                    currentQuizIndex = (currentQuizIndex + 1) % quizQuestions.length;
                    loadQuiz();
                }, 1200);
            } else {
                playPixelSound(150, 'sawtooth', 0.25);
                feedback.style.color = '#E87305';
                feedback.innerText = "❌ KURANG TEPAT, COBA LAGI!";
            }
        }

        // Particle Canvas Background
        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        for (let i = 0; i < 35; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 3 + 1,
                speedX: (Math.random() - 0.5) * 0.5,
                speedY: (Math.random() - 0.5) * 0.5,
                color: i % 2 === 0 ? '#5FCA00' : '#E87305'
            });
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.x += p.speedX;
                p.y += p.speedY;

                if (p.x < 0 || p.x > canvas.width) p.speedX *= -1;
                if (p.y < 0 || p.y > canvas.height) p.speedY *= -1;

                ctx.fillStyle = p.color;
                ctx.fillRect(Math.floor(p.x), Math.floor(p.y), p.size, p.size);
            });
            requestAnimationFrame(animateParticles);
        }

        // Initialize
        loadQuiz();
        animateParticles();
    </script>
</body>
</html>
